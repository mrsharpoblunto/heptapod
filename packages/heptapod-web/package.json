{
  "name": "@thestraylight/heptapod-web",
  "version": "0.1.0",
  "description": "Next.js viewer for Heptapod narrative code reviews.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "heptapod-web": "scripts/heptapod-web.mjs",
    "heptapod-web-dev": "scripts/heptapod-web-dev.mjs"
  },
  "files": [
    ".next/*.json",
    ".next/*.js",
    ".next/BUILD_ID",
    ".next/server",
    ".next/static",
    "app",
    "src",
    "scripts",
    "next.config.ts",
    "postcss.config.mjs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrsharpoblunto/heptapod.git",
    "directory": "packages/heptapod-web"
  },
  "homepage": "https://github.com/mrsharpoblunto/heptapod#readme",
  "bugs": "https://github.com/mrsharpoblunto/heptapod/issues",
  "keywords": ["code-review", "diff", "github", "nextjs"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/heptapod-web.mjs --dev",
    "start": "next start",
    "build": "next build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@thestraylight/heptapod": "0.1.0",
    "@tailwindcss/postcss": "^4.2.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^6.0.0",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.10"
  }
}
