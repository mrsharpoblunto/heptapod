{
  "name": "@thestraylight/heptapod-api",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Local background API server for Heptapod reviews.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrsharpoblunto/heptapod.git",
    "directory": "packages/heptapod-api"
  },
  "homepage": "https://github.com/mrsharpoblunto/heptapod#readme",
  "bugs": "https://github.com/mrsharpoblunto/heptapod/issues",
  "keywords": [
    "code-review",
    "diff",
    "github",
    "ai-agent"
  ],
  "bin": {
    "heptapod-api": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "pnpm run build && vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "prepack": "pnpm run build",
    "dev": "pnpm run build && node dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@thestraylight/heptapod-core": "workspace:^"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^24.10.0",
    "eslint": "9.39.5",
    "globals": "^17.6.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.10"
  }
}
