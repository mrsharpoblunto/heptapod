{
  "name": "@thestraylight/heptapod-core",
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "description": "Shared capture, validation, ingestion, and agent preparation APIs for Heptapod.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrsharpoblunto/heptapod.git",
    "directory": "packages/heptapod-core"
  },
  "homepage": "https://github.com/mrsharpoblunto/heptapod#readme",
  "bugs": "https://github.com/mrsharpoblunto/heptapod/issues",
  "keywords": [
    "code-review",
    "diff",
    "github",
    "ai-agent"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/tool/index.d.ts",
      "import": "./dist/tool/index.js"
    },
    "./*": {
      "types": "./dist/tool/*.d.ts",
      "import": "./dist/tool/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "pnpm run build && vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@swc/core": "^1.16.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^24.10.0",
    "eslint": "9.39.5",
    "globals": "^17.6.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.10"
  }
}
