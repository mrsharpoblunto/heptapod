{
  "test": {
    "fixtures": {
      "format": "javascript"
    },
    "prerequisites": [
      {
        "command": [
          "pnpm",
          "install",
          "--frozen-lockfile"
        ]
      }
    ],
    "build": [
      {
        "command": [
          "pnpm",
          "--filter",
          "@thestraylight/heptapod-core",
          "build"
        ]
      },
      {
        "command": [
          "pnpm",
          "--filter",
          "@thestraylight/heptapod-api",
          "build"
        ]
      },
      {
        "command": [
          "pnpm",
          "--filter",
          "@thestraylight/heptapod",
          "build"
        ]
      }
    ],
    "runner": {
      "format": "vitest",
      "rebuild": "always",
      "command": [
        "pnpm",
        "test",
        "{files}"
      ]
    }
  }
}
